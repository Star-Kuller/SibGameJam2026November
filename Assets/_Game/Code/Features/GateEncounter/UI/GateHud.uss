#screen {
    flex-grow: 1;
    color: rgb(214, 210, 196);
    font-size: 18px;
    -unity-font: url("../../../../../TextMesh Pro/Fonts/LiberationSans.ttf");
}
#hud, #cctv-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
.topbar {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 18px;
    height: 78px;
    padding: 10px 22px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(15, 17, 17, 0.92);
    border-width: 1px;
    border-color: rgb(83, 83, 75);
}
.camera-label {
    padding-right: 26px;
    border-right-width: 1px;
    border-right-color: rgb(78, 78, 70);
}
.camera-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(226, 216, 191);
}
.eyebrow {
    font-size: 18px;
    color: rgb(176, 178, 170);
}
.micro {
    font-size: 18px;
    color: rgb(153, 158, 152);
}
.clock-panel {
    align-items: flex-end;
}
.clock-value {
    font-size: 26px;
    color: rgb(217, 210, 188);
    -unity-font-style: bold;
}
.people-panel {
    position: absolute;
    top: 114px;
    left: 24px;
    width: 330px;
    padding: 15px 18px;
    background-color: rgba(18, 21, 20, 0.85);
    border-width: 1px;
    border-color: rgb(73, 77, 71);
}
.people-list {
    font-size: 18px;
    white-space: normal;
    margin-top: 8px;
    color: rgb(131, 191, 179);
}
#notification {
    position: absolute;
    top: 122px;
    left: 31%;
    right: 20%;
    padding: 10px 16px;
    background-color: rgba(16, 18, 17, 0.9);
    border-left-width: 2px;
    border-left-color: rgb(106, 168, 153);
    font-size: 19px;
    white-space: normal;
    display: none;
}
#notification.danger {
    border-left-color: rgb(171, 67, 46);
    color: rgb(229, 170, 142);
}
#crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 24px;
    height: 24px;
    translate: -50% -50%;
}
.crosshair-horizontal {
    position: absolute;
    top: 11px;
    left: 0;
    width: 24px;
    height: 1px;
    background-color: rgb(218, 216, 197);
}
.crosshair-vertical {
    position: absolute;
    top: 0;
    left: 11px;
    width: 1px;
    height: 24px;
    background-color: rgb(218, 216, 197);
}
#hit-marker {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    font-size: 55px;
    display: none;
}
#target-name {
    position: absolute;
    left: 30%;
    right: 30%;
    top: 55%;
    font-size: 20px;
    -unity-text-align: middle-center;
}
.bottombar {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 52px;
    height: 110px;
    padding: 12px 22px;
    background-color: rgba(13, 16, 15, 0.94);
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-width: 1px;
    border-color: rgb(83, 83, 75);
}
.health-panel {
    width: 290px;
    margin-right: 24px;
}
.health-caption {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}
.health-track {
    height: 10px;
    background-color: rgb(38, 44, 41);
    border-width: 1px;
    border-color: rgb(85, 94, 86);
}
#health-fill {
    flex-grow: 1;
    width: 100%;
    background-color: rgb(91, 145, 123);
}
#health-fill.critical {
    background-color: rgb(173, 65, 43);
}
.danger-text {
    color: rgb(223, 126, 87);
}
.commands {
    align-items: center;
}
.command-buttons {
    flex-direction: row;
}
.command-buttons Button {
    width: 188px;
    margin-left: 5px;
    margin-right: 5px;
    height: 50px;
    font-size: 20px;
}
#command-caption {
    margin-top: 4px;
    font-size: 18px;
}
.ammo-panel {
    min-width: 130px;
    margin-left: 24px;
    align-items: flex-end;
}
.ammo-value {
    font-size: 35px;
    color: rgb(219, 189, 129);
    -unity-font-style: bold;
}
.status-line {
    position: absolute;
    bottom: 16px;
    left: 26px;
    right: 26px;
    flex-direction: row;
    justify-content: space-between;
    font-size: 18px;
    color: rgb(162, 166, 155);
}
#controls-hint {
    font-size: 18px;
}
#menu-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 10, 10, 0.76);
}
.menu-shell {
    width: 640px;
    padding: 32px 42px;
    background-color: rgba(21, 24, 23, 0.98);
    border-width: 1px;
    border-color: rgb(96, 95, 83);
}
#menu-title {
    font-size: 34px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 28px;
    -unity-text-align: middle-center;
    color: rgb(222, 216, 195);
}
#menu-title.main-title {
    font-size: 37px;
    letter-spacing: 2px;
}
#menu-subtitle, #run-results {
    font-size: 20px;
    white-space: normal;
    margin-bottom: 22px;
    color: rgb(190, 185, 165);
}
Button {
    height: 52px;
    margin-top: 9px;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgb(32, 36, 34);
    color: rgb(217, 212, 193);
    font-size: 23px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 1px;
    border-left-color: rgb(103, 104, 92);
    border-top-color: rgb(103, 104, 92);
    border-right-color: rgb(51, 54, 48);
    border-bottom-color: rgb(51, 54, 48);
    border-radius: 2px;
}
Button:hover {
    background-color: rgb(55, 49, 35);
    border-color: rgb(171, 130, 65);
    color: rgb(236, 203, 133);
}
Button:focus {
    border-color: rgb(181, 147, 88);
}
Button:active {
    background-color: rgb(37, 32, 23);
    border-color: rgb(137, 104, 54);
}
Button:disabled {
    background-color: rgb(24, 27, 25);
    color: rgb(99, 104, 97);
    border-color: rgb(48, 52, 46);
}
.primary-action {
    height: 58px;
}
#settings-panel {
    display: none;
}
.settings-title {
    font-size: 31px;
    -unity-font-style: bold;
    margin-bottom: 20px;
}
.settings-caption {
    font-size: 19px;
    color: rgb(190, 185, 165);
    margin-top: 16px;
    margin-bottom: 9px;
}
Slider {
    height: 36px;
    margin-bottom: 6px;
}
Slider Label {
    width: 200px;
    font-size: 19px;
}
Slider TextField {
    min-width: 65px;
}
#cctv-enabled {
    height: 32px;
    font-size: 19px;
}
.binding-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2px;
}
.binding-row Label {
    font-size: 20px;
}
.binding-row Button {
    width: 245px;
    height: 36px;
    margin-top: 0;
    font-size: 19px;
}
#settings-panel .unity-base-text-field__input {
    color: rgb(221, 216, 196);
    background-color: rgb(33, 38, 34);
    border-width: 1px;
    border-color: rgb(83, 91, 77);
}
#settings-panel .unity-base-slider__dragger {
    background-color: rgb(179, 153, 105);
}
#rebind-message {
    font-size: 18px;
    white-space: normal;
    color: rgb(205, 180, 131);
    margin-top: 12px;
    margin-bottom: 4px;
}
#cancel-rebind {
    display: none;
}
#reset-controls, #settings-back, #cancel-rebind {
    height: 40px;
    font-size: 19px;
}
.hidden {
    display: none;
}
