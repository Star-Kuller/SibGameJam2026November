<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="GateHud.uss" />
    <ui:VisualElement name="screen" picking-mode="Ignore">
        <ui:VisualElement name="hud" picking-mode="Ignore">
            <ui:VisualElement name="cctv-overlay" picking-mode="Ignore" />
            <ui:VisualElement class="topbar metal-plate" picking-mode="Ignore">
                <ui:VisualElement class="camera-label">
                    <ui:Label text="CAM 01" class="camera-title" />
                    <ui:Label text="ГЛАВНЫЕ ВОРОТА" class="micro" />
                </ui:VisualElement>
                <ui:Label name="population" text="ЛЮДИ  8 / СВОБОДНЫ  8 / СНАРУЖИ  0" />
                <ui:Label name="metal" text="МЕТАЛЛ  24" />
                <ui:VisualElement class="clock-panel">
                    <ui:Label text="ДО РАССВЕТА" class="micro" />
                    <ui:Label name="clock" text="12:00" class="clock-value" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="people-panel" class="people-panel metal-plate" picking-mode="Ignore">
                <ui:Label text="ЛЮДИ СНАРУЖИ" class="eyebrow" />
                <ui:VisualElement name="people-list" class="people-list" />
            </ui:VisualElement>
            <ui:VisualElement name="resident-picker" class="metal-plate">
                <ui:Label text="ВЫЛАЗКА" class="eyebrow" />
                <ui:Label text="1 житель · 62 с · груз 12 металла и 30 патронов" class="person-status" />
                <ui:ScrollView name="resident-choices" />
                <ui:Label name="resident-selection" class="person-status" />
                <ui:Button name="confirm-expedition" text="Отправить" />
                <ui:Button name="cancel-expedition" text="Отмена" />
            </ui:VisualElement>
            <ui:Label name="notification" text="" picking-mode="Ignore" />
            <ui:Label name="wave-announcement" text="" picking-mode="Ignore" />
            <ui:VisualElement name="crosshair" picking-mode="Ignore">
                <ui:VisualElement class="crosshair-horizontal" />
                <ui:VisualElement class="crosshair-vertical" />
            </ui:VisualElement>
            <ui:Label name="hit-marker" text="×" picking-mode="Ignore" />
            <ui:Label name="target-name" text="" picking-mode="Ignore" />
            <ui:VisualElement class="bottombar metal-plate" picking-mode="Ignore">
                <ui:VisualElement class="health-panel">
                    <ui:VisualElement class="health-caption">
                        <ui:Label text="ВОРОТА" class="eyebrow" />
                        <ui:VisualElement name="gate-damage-icon" tooltip="Ворота повреждены: прочность ниже 30%">
                            <ui:VisualElement class="crack crack-top" />
                            <ui:VisualElement class="crack crack-middle" />
                            <ui:VisualElement class="crack crack-bottom" />
                        </ui:VisualElement>
                        <ui:Label name="health" text="300 / 300" />
                    </ui:VisualElement>
                    <ui:VisualElement class="health-track">
                        <ui:VisualElement name="health-fill" />
                    </ui:VisualElement>
                    <ui:Label name="gate-state" text="ЗАКРЫТЫ" class="micro" />
                </ui:VisualElement>
                <ui:VisualElement class="commands">
                    <ui:VisualElement class="command-buttons">
                        <ui:Button name="toggle-gate" text="Открыть ворота" class="metal-plate" />
                        <ui:Button name="dispatch-person" text="Вылазка" class="metal-plate" />
                        <ui:Button name="recall-people" text="Отозвать" class="metal-plate" />
                    </ui:VisualElement>
                    <ui:Label name="command-caption" text="" class="micro" />
                </ui:VisualElement>
                <ui:VisualElement class="ammo-panel">
                    <ui:Label text="ПАТРОНЫ" class="eyebrow" />
                    <ui:Label name="rounds" text="180" class="ammo-value" />
                    <ui:Label name="kills" text="000" class="hidden" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="status-line" picking-mode="Ignore">
                <ui:Label name="control-mode" text="ТУРЕЛЬ" />
                <ui:Label name="controls-hint" text="" />
                <ui:Label name="enemies" text="УГРОЗЫ 00" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="menu-overlay">
            <ui:VisualElement class="menu-shell metal-plate">
                <ui:VisualElement name="menu-home">
                    <ui:Label name="menu-title" text="ПОСЛЕДНЯЯ СМЕНА" />
                    <ui:Label name="menu-subtitle" text="" />
                    <ui:ScrollView name="run-results-scroll">
                        <ui:Label name="run-results" text="" />
                    </ui:ScrollView>
                    <ui:Button name="start" text="Старт" class="primary-action metal-plate" />
                    <ui:Button name="resume" text="Продолжить" class="primary-action metal-plate" />
                    <ui:Button name="restart" text="Заново" class="primary-action metal-plate" />
                    <ui:Button name="back-main" text="Главное меню" class="metal-plate" />
                    <ui:Button name="open-settings" text="Настройки" class="metal-plate" />
                    <ui:Button name="quit" text="Выход" class="metal-plate" />
                </ui:VisualElement>
                <ui:VisualElement name="settings-panel">
                    <ui:Label text="Настройки" class="settings-title" />
                    <ui:Slider name="mouse-sensitivity" label="Чувствительность" low-value="0.02" high-value="0.5" show-input-field="true" />
                    <ui:Slider name="master-volume" label="Громкость" low-value="0" high-value="1" show-input-field="true" />
                    <ui:Toggle name="cctv-enabled" label="Эффект CCTV" value="true" />
                    <ui:Label text="Управление" class="settings-caption" />
                    <ui:VisualElement class="binding-row">
                        <ui:Label text="Огонь" />
                        <ui:Button name="bind-Attack" />
                    </ui:VisualElement>
                    <ui:VisualElement class="binding-row">
                        <ui:Label text="Пауза" />
                        <ui:Button name="bind-Pause" />
                    </ui:VisualElement>
                    <ui:VisualElement class="binding-row">
                        <ui:Label text="Ворота" />
                        <ui:Button name="bind-Gate" />
                    </ui:VisualElement>
                    <ui:VisualElement class="binding-row">
                        <ui:Label text="Отозвать" />
                        <ui:Button name="bind-Recall" />
                    </ui:VisualElement>
                    <ui:VisualElement class="binding-row">
                        <ui:Label text="Курсор / турель" />
                        <ui:Button name="bind-CommandCursor" />
                    </ui:VisualElement>
                    <ui:Label name="rebind-message" text="" />
                    <ui:Button name="cancel-rebind" text="Отмена переназначения" />
                    <ui:Button name="reset-controls" text="По умолчанию" />
                    <ui:Button name="settings-back" text="Назад" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
