<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../GateEncounter/GateHud.uss" />
    <ui:VisualElement name="screen">
        <ui:VisualElement name="menu-overlay">
            <ui:VisualElement class="menu-shell metal-plate">
                <ui:VisualElement name="menu-home">
                    <ui:Label name="menu-title" text="ПОСЛЕДНЯЯ СМЕНА" class="main-title" />
                    <ui:Button name="start" text="Старт" class="primary-action metal-plate" />
                    <ui:Button name="open-settings" text="Настройки" class="metal-plate" />
                    <ui:Button name="quit" text="Выход" class="metal-plate" />
                </ui:VisualElement>
                <ui:VisualElement name="settings-panel" xmlns:ui="UnityEngine.UIElements">
                    <ui:Label text="Настройки" class="settings-title" />
                    <ui:Slider name="mouse-sensitivity" label="Чувствительность" low-value="0.02" high-value="0.5" show-input-field="true" />
                    <ui:Slider name="master-volume" label="Громкость" low-value="0" high-value="1" show-input-field="true" />
                    <ui:Toggle name="cctv-enabled" label="Эффект CCTV" value="true" />
                    <ui:Label text="Управление" class="settings-caption" />
                    <ui:VisualElement class="binding-row">
                        <ui:Label text="Огонь" />
                        <ui:Button name="bind-Attack" />
                    </ui:VisualElement>
                    <ui:VisualElement class="binding-row">
                        <ui:Label text="Пауза" />
                        <ui:Button name="bind-Pause" />
                    </ui:VisualElement>
                    <ui:VisualElement class="binding-row">
                        <ui:Label text="Ворота" />
                        <ui:Button name="bind-Gate" />
                    </ui:VisualElement>
                    <ui:VisualElement class="binding-row">
                        <ui:Label text="Отозвать" />
                        <ui:Button name="bind-Recall" />
                    </ui:VisualElement>
                    <ui:VisualElement class="binding-row">
                        <ui:Label text="Курсор / турель" />
                        <ui:Button name="bind-CommandCursor" />
                    </ui:VisualElement>
                    <ui:Label name="rebind-message" text="" />
                    <ui:Button name="cancel-rebind" text="Отмена переназначения" />
                    <ui:Button name="reset-controls" text="По умолчанию" />
                    <ui:Button name="settings-back" text="Назад" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>